# ── OpenSearch ─────────────────────────────────────────────────────────────────
# Must match the index created by the ingestion pipeline
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=hpe-search-docs

# ── Search Tuning ──────────────────────────────────────────────────────────────
SEARCH_KNN_K=50
SEARCH_BM25_BOOST=0.4
SEARCH_KNN_BOOST=0.6
SEARCH_DEFAULT_SIZE=10

# ── PyWorker-2 (gRPC) ──────────────────────────────────────────────────────────
GRPC_SEARCH_PORT=50052

# Embedding model — cached via HuggingFace (~90 MB, downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Redis Cache ─────────────────────────────────────────────────────────────────
# Used by Go Gateway for Steps 1 & 4 of the search pipeline (cache HIT/STORE)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# TTL settings (seconds)
REDIS_TTL_DEFAULT=300
REDIS_TTL_POPULAR=1800
REDIS_POPULAR_THRESHOLD=10

# ── Go Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ── Frontend ───────────────────────────────────────────────────────────────────
# Leave blank — frontend auto-routes through go-gateway at localhost:8080
# Override only if gateway is on a different host (e.g. NEXT_PUBLIC_API_BASE=http://192.168.x.x:8080)
NEXT_PUBLIC_API_BASE=

# ── Observability ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
