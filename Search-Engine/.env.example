# ── OpenSearch ─────────────────────────────────────────────────────────────────
# Host running OpenSearch (Role 3's server IP in integrated deployment)
# Leave as 'localhost' to use the local container from docker-compose
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=object-storage-index

# ── PyWorker-2 (gRPC) ──────────────────────────────────────────────────────────
GRPC_SEARCH_PORT=50052

# Embedding model — cached via HuggingFace (~90 MB, downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Go Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ── Frontend ───────────────────────────────────────────────────────────────────
# Leave blank — frontend auto-routes through go-gateway at localhost:8080
# Override only if gateway is on a different host (e.g. NEXT_PUBLIC_API_BASE=http://192.168.x.x:8080)
NEXT_PUBLIC_API_BASE=
