{
  "settings": {
    "index": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "knn": true,
      "knn.algo_param.ef_search": 512
    },
    "analysis": {
      "analyzer": {
        "filename_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "filename_stop"]
        }
      },
      "filter": {
        "filename_stop": {
          "type": "stop",
          "stopwords": "_english_"
        }
      }
    }
  },
  "mappings": {
    "properties": {

      "doc_id": {
        "type": "keyword",
        "doc_values": true
      },

      "filename": {
        "type": "text",
        "analyzer": "filename_analyzer",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 512 },
          "suggest":  { "type": "completion" }
        }
      },

      "extension": {
        "type": "keyword"
      },

      "mime_type": {
        "type": "keyword"
      },

      "bucket": {
        "type": "keyword"
      },

      "object_key": {
        "type": "keyword"
      },

      "download_url": {
        "type": "keyword",
        "index": false
      },

      "owner": {
        "type": "keyword"
      },

      "size_bytes": {
        "type": "long"
      },

      "uploaded_at": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },

      "indexed_at": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },

      "chunk_index": {
        "type": "integer"
      },

      "chunk_total": {
        "type": "integer"
      },

      "chunk_text": {
        "type": "text",
        "analyzer": "standard",
        "term_vector": "with_positions_offsets"
      },

      "language": {
        "type": "keyword"
      },

      "tags": {
        "type": "keyword"
      },

      "author": {
        "type": "text",
        "analyzer": "standard",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 512 }
        }
      },

      "title": {
        "type": "text",
        "analyzer": "standard",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 512 }
        }
      },

      "page_count": {
        "type": "integer"
      },

      "doc_created_at": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },

      "embedding": {
        "type": "knn_vector",
        "dimension": 1536,
        "method": {
          "name": "hnsw",
          "engine": "nmslib",
          "space_type": "cosinesimil",
          "parameters": {
            "ef_construction": 512,
            "m": 16
          }
        }
      },

      "ingestion_status": {
        "type": "keyword"
      },

      "error_message": {
        "type": "keyword",
        "index": false
      }
    }
  }
}
